APP_ENV=development
# Local MongoDB or MongoDB Atlas connection string (NEVER commit real credentials).
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=farmlink
JWT_SECRET_KEY=replace-with-a-secure-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# First administrator (created by the seed script only — change before deploying).
SEED_ADMIN_EMAIL=admin@farmlink.example.com
SEED_ADMIN_PASSWORD=change-me-before-deploy
